  </modules>
  <profiles>
    <profile>
      <id>verification</id>
      <modules>
        <module>test/smartscity-id-compatibility-tests</module>
      </modules>
    </profile>
    <profile>
      <id>benchmarks</id>
      <modules>
        <module>test/smartscity-id-benchmark</module>
      </modules>
    </profile>
    <profile>
      <id>samples</id>
      <modules>
        <module>samples/id</module>
      </modules>
    </profile>
  </profiles>
</project>
