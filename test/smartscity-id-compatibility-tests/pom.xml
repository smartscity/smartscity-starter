<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.smartscity</groupId>
    <artifactId>smartscity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../build/smartscity-parent/pom.xml</relativePath>
  </parent>
  <artifactId>smartscity-id-compatibility-tests</artifactId>
  <packaging>jar</packaging>
  <name>smartscity-id-compatibility-tests</name>
  <description>Smartscity independent Spring Boot extensions: smartscity-id-compatibility-tests.</description>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <id.starter.artifact>smartscity-starter-id</id.starter.artifact>
    <maven.compiler.release>9</maven.compiler.release>
    <java.module.name>com.smartscity.id.compatibility.tests</java.module.name>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.smartscity</groupId>
      <artifactId>${id.starter.artifact}</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>boot3</id>
      <properties>
        <spring-boot.version>3.5.16</spring-boot.version>
        <id.starter.artifact>smartscity-starter-id</id.starter.artifact>
      </properties>
    </profile>
    <profile>
      <id>boot4</id>
      <properties>
        <spring-boot.version>${boot4.version}</spring-boot.version>
        <id.starter.artifact>smartscity-starter-id-boot4</id.starter.artifact>
      </properties>
    </profile>
  </profiles>
</project>
